{
  "name": "favicon-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "icons": "node scripts/build-icons.mjs",
    "fonts:check": "bun scripts/check-fonts.ts",
    "cli": "bun cli/src/index.ts",
    "cli:build": "bun build cli/src/index.ts --target=node --format=esm --outfile=cli/dist/index.js --external @napi-rs/canvas --banner '#!/usr/bin/env node' && cp public/lucide.json cli/dist/lucide.json",
    "brand": "bun scripts/build-brand.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.8.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@napi-rs/canvas": "^1.0.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
